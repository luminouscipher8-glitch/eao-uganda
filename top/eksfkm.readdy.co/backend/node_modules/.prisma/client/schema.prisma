generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model auth_users {
  id         String           @id
  email      String
  phone      String?
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  analytics  AnalyticsEvent[]
  contacts   Contact[]
  donations  Donation[]
  profiles   UserProfile?

  @@map("users")
}

model UserProfile {
  id          String     @id @default(cuid())
  userId      String     @unique
  username    String?    @unique
  firstName   String?
  lastName    String?
  avatar      String?
  bio         String?
  role        Role       @default(USER)
  isActive    Boolean    @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authUser    auth_users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Contact {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  phone     String?
  company   String?
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    String?
  user      auth_users?   @relation(fields: [userId], references: [id])

  @@map("contacts")
}

model Payment {
  id                 String        @id @default(dbgenerated("gen_random_uuid()::text"))
  type               PaymentType
  merchant_reference String        @unique
  tracking_id        String?       @unique
  amount             Float
  currency           String        @default("UGX")
  status             PaymentStatus @default(PENDING)
  pesapal_status     String?
  payment_method     String?
  provider           String        @default("pesapal")
  metadata           Json?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  donation           Donation?
  orders             Order?

  @@map("payments")
}

model Order {
  id            String   @id @default(cuid())
  payment_id    String   @unique
  status        String   @default("AWAITING_PAYMENT")
  total_amount  Float
  currency      String   @default("UGX")
  customer_info Json
  shipping_info Json?
  order_items   Json
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  payment       Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@map("orders")
}

model Donation {
  id                       String         @id @default(cuid())
  payment_id               String?        @unique
  amount                   Float
  currency                 String         @default("UGX")
  flutterwaveTxRef         String?        @unique
  flutterwaveTransactionId String?
  status                   DonationStatus @default(PENDING)
  message                  String?
  is_anonymous             Boolean        @default(false)
  donor_name               String?
  donor_email              String?
  donor_phone              String?
  payment_method           String?
  is_recurring             Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updated_at               DateTime       @updatedAt
  userId                   String?
  campaignId               String?
  campaign                 Campaign?      @relation(fields: [campaignId], references: [id])
  payment                  Payment?       @relation(fields: [payment_id], references: [id])
  user                     auth_users?    @relation(fields: [userId], references: [id])

  @@map("donations")
}

model AnalyticsEvent {
  id        String      @id @default(cuid())
  userId    String?
  eventName String
  eventData Json?
  sessionId String?
  ipAddress String?
  userAgent String?
  referrer  String?
  createdAt DateTime    @default(now())
  user      auth_users? @relation(fields: [userId], references: [id])

  @@map("analytics_events")
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  is_active Boolean  @default(true)
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletters")
}

model News {
  id             String    @id @default(cuid())
  title          String
  content        String
  excerpt        String?
  featured_image String?
  author         String?   @default("EAO Team")
  status         String    @default("draft")
  published_at   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("news")
}

model Campaign {
  id            String     @id @default(cuid())
  title         String
  description   String
  goalAmount    Float
  currentAmount Float      @default(0)
  currency      String     @default("UGX")
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean    @default(true)
  imageUrl      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  donations     Donation[]

  @@map("campaigns")
}

model Volunteer {
  id                    String                   @id @default(cuid())
  email                 String                   @unique
  phone                 String?
  date_of_birth         DateTime?
  age                   Int?
  gender                Gender?
  address               String?
  city                  String?
  country               String                   @default("Uganda")
  profile_image         String?
  bio                   String?
  skills                String[]
  interests             String[]
  availability          Availability?
  occupation            String?
  motivation            String?
  emergency_contact     String?
  emergency_phone       String?
  status                VolunteerStatus          @default(PENDING)
  application_date      DateTime                 @default(now())
  approved_date         DateTime?
  last_login_at         DateTime?
  total_hours           Float                    @default(0)
  background_check      Boolean                  @default(false)
  background_check_date DateTime?
  notes                 String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  name                  String                   @db.VarChar(255)
  eventAttendees        EventAttendee[]
  assignments           VolunteerAssignment[]
  certifications        VolunteerCertification[]
  communications        VolunteerCommunication[]
  documents             VolunteerDocument[]
  hours                 VolunteerHour[]
  reviews               VolunteerReview[]
  trainings             VolunteerTraining[]

  @@map("volunteers")
}

model VolunteerAssignment {
  id          String           @id @default(cuid())
  volunteerId String
  eventId     String?
  programId   String?
  role        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  status      AssignmentStatus @default(SCHEDULED)
  location    String?
  supervisor  String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  event       Event?           @relation(fields: [eventId], references: [id])
  program     Program?         @relation(fields: [programId], references: [id])
  volunteer   Volunteer        @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_assignments")
}

model VolunteerHour {
  id          String     @id @default(cuid())
  volunteerId String
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  hours       Float
  activity    String
  location    String?
  supervisor  String?
  notes       String?
  status      HourStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  volunteer   Volunteer  @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_hours")
}

model VolunteerDocument {
  id           String         @id @default(cuid())
  volunteerId  String
  documentType DocumentType
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  status       DocumentStatus @default(PENDING)
  uploadedBy   String?
  notes        String?
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  volunteer    Volunteer      @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_documents")
}

model VolunteerCertification {
  id               String              @id @default(cuid())
  volunteerId      String
  name             String
  issuer           String
  issueDate        DateTime
  expiryDate       DateTime?
  credentialNumber String?
  fileUrl          String?
  status           CertificationStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  volunteer        Volunteer           @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_certifications")
}

model VolunteerTraining {
  id             String         @id @default(cuid())
  volunteerId    String
  title          String
  description    String?
  instructor     String?
  date           DateTime
  duration       Float
  location       String?
  type           TrainingType
  status         TrainingStatus @default(SCHEDULED)
  completionDate DateTime?
  certificateUrl String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  volunteer      Volunteer      @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_trainings")
}

model VolunteerReview {
  id           String       @id @default(cuid())
  volunteerId  String
  reviewerId   String?
  period       String
  rating       Int
  strengths    String?
  improvements String?
  goals        String?
  status       ReviewStatus @default(DRAFT)
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  volunteer    Volunteer    @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_reviews")
}

model VolunteerCommunication {
  id           String            @id @default(cuid())
  volunteerId  String
  type         CommunicationType
  subject      String
  message      String
  channel      String
  status       MessageStatus     @default(PENDING)
  sentAt       DateTime?
  scheduledFor DateTime?
  response     String?
  respondedAt  DateTime?
  createdBy    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  volunteer    Volunteer         @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_communications")
}

model Event {
  id                    String                @id @default(cuid())
  title                 String
  description           String
  type                  EventType
  event_date            DateTime
  end_date              DateTime?
  location              String
  max_attendees         Int?
  current_attendees     Int                   @default(0)
  image                 String?
  status                EventStatus           @default(PLANNING)
  is_public             Boolean               @default(true)
  registration_required Boolean               @default(true)
  registration_deadline DateTime?
  cost                  Float?
  funds_raised          Float?
  currency              String?
  skills                String[]
  is_featured           Boolean               @default(false)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  attendees             EventAttendee[]
  assignments           VolunteerAssignment[]

  @@map("events")
}

model EventAttendee {
  id           String         @id @default(cuid())
  eventId      String
  volunteerId  String?
  name         String
  email        String
  phone        String?
  status       AttendeeStatus @default(REGISTERED)
  registeredAt DateTime       @default(now())
  checkedInAt  DateTime?
  notes        String?
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer    Volunteer?     @relation(fields: [volunteerId], references: [id])

  @@map("event_attendees")
}

model Program {
  id            String                @id @default(cuid())
  title         String
  description   String
  impact        String
  category      String
  image         String?
  is_active     Boolean               @default(true)
  type          ProgramType
  status        ProgramStatus         @default(ACTIVE)
  start_date    DateTime
  end_date      DateTime?
  budget        Float?
  location      String?
  coordinator   String?
  goals         String[]
  metrics       Json?
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  beneficiaries Beneficiary[]
  reports       ProgramReport[]
  assignments   VolunteerAssignment[]

  @@map("programs")
}

model Beneficiary {
  id             String            @id @default(cuid())
  programId      String
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         Gender?
  address        String?
  phone          String?
  email          String?
  school         String?
  grade          String?
  enrollmentDate DateTime          @default(now())
  status         BeneficiaryStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  program        Program           @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("beneficiaries")
}

model ProgramReport {
  id          String       @id @default(cuid())
  programId   String
  title       String
  content     String
  period      String
  metrics     Json
  attachments String[]
  status      ReportStatus @default(DRAFT)
  submittedBy String?
  submittedAt DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  program     Program      @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_reports")
}

model SchoolBuilding {
  id                  String    @id @default(cuid())
  title               String
  description         String
  phase               String
  status              String    @default("pending")
  start_date          DateTime?
  end_date            DateTime?
  budget              Float?
  target_amount       Float?
  raised_amount       Float?
  currency            String?
  progress_percentage Int       @default(0)
  image               String?
  completion_date     DateTime?
  is_featured         Boolean   @default(false)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("school_building")
}

model SuccessStory {
  id           String   @id @default(cuid())
  student_name String
  age          Int?
  story        String
  impact       String
  category     String   @default("education")
  image        String?
  is_featured  Boolean  @default(false)
  status       String   @default("published")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("success_stories")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum ContactStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  DONATION
  SHOP
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum VolunteerStatus {
  PENDING
  APPROVED
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Availability {
  WEEKDAYS
  WEEKENDS
  FLEXIBLE
  SPECIFIC_DAYS
}

enum AssignmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum HourStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  ID_CARD
  PASSPORT
  RESUME
  CERTIFICATE
  BACKGROUND_CHECK
  MEDICAL_FORM
  AGREEMENT
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum CertificationStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum TrainingType {
  ORIENTATION
  SKILLS_TRAINING
  SAFETY_TRAINING
  LEADERSHIP
  FIRST_AID
  CHILD_PROTECTION
}

enum TrainingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum CommunicationType {
  WELCOME
  REMINDER
  ANNOUNCEMENT
  SURVEY
  WARNING
  APPRECIATION
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  RESPONDED
}

enum EventType {
  FUNDRAISING
  VOLUNTEER_ORIENTATION
  COMMUNITY_SERVICE
  TRAINING
  AWARENESS_CAMPAIGN
  RECRUITMENT_DRIVE
  CELEBRATION
  MEETING
}

enum EventStatus {
  PLANNING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum AttendeeStatus {
  REGISTERED
  CONFIRMED
  CHECKED_IN
  NO_SHOW
  CANCELLED
}

enum ProgramType {
  EDUCATION
  MENTORSHIP
  HEALTH
  NUTRITION
  COMMUNITY_DEVELOPMENT
  ADVOCACY
  RESEARCH
}

enum ProgramStatus {
  PLANNING
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED
}

enum BeneficiaryStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  SUSPENDED
  INACTIVE
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}
