// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Reference Supabase auth.users table for user relationships
model auth_users {
  // Supabase manages this table - we only reference it
  id            String   @id
  email         String
  phone         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  // Relations to our custom tables
  profiles      UserProfile?
  contacts      Contact[]
  donations     Donation[]
  analytics     AnalyticsEvent[]

  @@map("users")
}

// Extended user profile data (additional fields beyond Supabase auth)
model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique // Foreign key to auth.users.id
  username    String?  @unique
  firstName   String?
  lastName    String?
  avatar      String?
  bio         String?
  role        Role     @default(USER)
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation to Supabase auth users
  authUser    auth_users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  phone     String?
  company   String?
  status    ContactStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String?
  user   auth_users? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("contacts")
}

// Payment Models for Pesapal Integration
model Payment {
  id                    String           @id @default(cuid())
  type                  PaymentType      // donation | shop
  merchant_reference    String           @unique
  tracking_id           String?          @unique // Pesapal order tracking ID
  amount                Float
  currency              String           @default("UGX")
  status                PaymentStatus    @default(PENDING)
  pesapal_status        String?          // Raw status from Pesapal
  payment_method        String?          // mobilemoney, card, banktransfer
  provider              String           @default("pesapal")
  metadata              Json?            // Store donor info, cart snapshot, etc.
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt

  // Relations
  donation              Donation?
  orders                Order[]

  @@map("payments")
}

model Order {
  id            String   @id @default(cuid())
  payment_id    String   @unique
  status        String   @default("AWAITING_PAYMENT") // AWAITING_PAYMENT, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  total_amount  Float
  currency      String   @default("UGX")
  customer_info Json     // Customer details
  shipping_info Json?    // Shipping details
  order_items   Json     // Cart items snapshot
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  payment       Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@map("orders")
}

// Updated Donation model to link with Payment
model Donation {
  id                    String           @id @default(cuid())
  payment_id            String?          @unique // Foreign key to payments table
  amount                Float
  currency              String           @default("UGX") // Uganda Shillings
  flutterwaveTxRef      String?          @unique // Legacy - keep for migration
  flutterwaveTransactionId String?        // Legacy - keep for migration
  status                DonationStatus   @default(PENDING)
  message               String?
  isAnonymous           Boolean          @default(false)
  donorName             String?          // For anonymous donations
  donorEmail            String?          // For anonymous donations
  donorPhone            String?          // For anonymous donations
  paymentMethod         String?          // mobile_money, card, etc.
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Relations
  userId String?
  user   auth_users? @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  payment    Payment?  @relation(fields: [payment_id], references: [id], onDelete: SetNull)

  @@map("donations")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventName String
  eventData Json?
  sessionId String?
  ipAddress String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  // Relations
  user auth_users? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("analytics_events")
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  source    String?  // Where the subscription came from
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletters")
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  description String
  goalAmount  Float
  currentAmount Float @default(0)
  currency    String @default("UGX")
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  donations Donation[]

  @@map("campaigns")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum ContactStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Payment Enums for Pesapal Integration
enum PaymentType {
  DONATION
  SHOP
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

// Volunteer Management Models
model Volunteer {
  id                String           @id @default(cuid())
  firstName         String
  lastName          String
  email             String           @unique
  phone             String?
  dateOfBirth       DateTime?
  gender            Gender?
  address           String?
  city              String?
  country           String           @default("Uganda")
  profileImage      String?
  bio               String?
  skills            String[]         // Array of skills
  interests         String[]         // Areas of interest
  availability      Availability?    // When they're available
  emergencyContact  String?          // Emergency contact name
  emergencyPhone    String?          // Emergency contact phone
  status            VolunteerStatus  @default(PENDING)
  applicationDate   DateTime         @default(now())
  approvedDate      DateTime?
  lastLoginAt       DateTime?
  totalHours        Float            @default(0)
  backgroundCheck   Boolean          @default(false)
  backgroundCheckDate DateTime?
  notes             String?          // Admin notes
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  assignments       VolunteerAssignment[]
  hours             VolunteerHour[]
  documents         VolunteerDocument[]
  certifications    VolunteerCertification[]
  trainings         VolunteerTraining[]
  reviews           VolunteerReview[]
  communications    VolunteerCommunication[]
  eventAttendees    EventAttendee[]

  @@map("volunteers")
}

model VolunteerAssignment {
  id          String   @id @default(cuid())
  volunteerId String
  eventId     String?  // If assigned to an event
  programId   String?  // If assigned to a program
  role        String   // Role in the assignment
  description String?  // What they'll be doing
  startDate   DateTime
  endDate     DateTime?
  status      AssignmentStatus @default(SCHEDULED)
  location    String?
  supervisor  String?  // Who they report to
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  program     Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@map("volunteer_assignments")
}

model VolunteerHour {
  id          String   @id @default(cuid())
  volunteerId String
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  hours       Float
  activity    String   // What they did
  location    String?
  supervisor  String?  // Who approved
  notes       String?
  status      HourStatus @default(PENDING)
  approvedBy  String?  // Admin who approved
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_hours")
}

model VolunteerDocument {
  id          String           @id @default(cuid())
  volunteerId String
  documentType DocumentType
  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  status      DocumentStatus  @default(PENDING)
  uploadedBy  String?         // Admin who uploaded
  notes       String?
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_documents")
}

model VolunteerCertification {
  id          String   @id @default(cuid())
  volunteerId String
  name        String   // Certificate name
  issuer      String   // Who issued it
  issueDate   DateTime
  expiryDate  DateTime?
  credentialNumber String?
  fileUrl     String?  // Certificate file
  status      CertificationStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_certifications")
}

model VolunteerTraining {
  id          String   @id @default(cuid())
  volunteerId String
  title       String
  description String?
  instructor  String?
  date        DateTime
  duration    Float    // Hours
  location    String?
  type        TrainingType
  status      TrainingStatus @default(SCHEDULED)
  completionDate DateTime?
  certificateUrl String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_trainings")
}

model VolunteerReview {
  id          String   @id @default(cuid())
  volunteerId String
  reviewerId  String?  // Admin who reviewed
  period      String   // Review period (e.g., "Q1 2024")
  rating      Int      // 1-5 scale
  strengths   String?
  improvements String?
  goals       String?
  status      ReviewStatus @default(DRAFT)
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_reviews")
}

model VolunteerCommunication {
  id          String           @id @default(cuid())
  volunteerId String
  type        CommunicationType
  subject     String
  message     String
  channel     String           // email, sms, phone
  status      MessageStatus    @default(PENDING)
  sentAt      DateTime?
  scheduledFor DateTime?
  response    String?
  respondedAt DateTime?
  createdBy   String?          // Admin who created
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@map("volunteer_communications")
}

// Event Management Models
model Event {
  id          String     @id @default(cuid())
  title       String
  description String
  type        EventType
  startDate   DateTime
  endDate     DateTime
  location    String
  maxAttendees Int?
  currentAttendees Int @default(0)
  imageUrl    String?
  status      EventStatus @default(PLANNING)
  isPublic    Boolean    @default(true)
  registrationRequired Boolean @default(true)
  registrationDeadline DateTime?
  cost        Float?     // Registration cost
  skills      String[]   // Required skills
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  assignments VolunteerAssignment[]
  attendees   EventAttendee[]

  @@map("events")
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  volunteerId String?
  name      String   // For non-volunteer attendees
  email     String
  phone     String?
  status    AttendeeStatus @default(REGISTERED)
  registeredAt DateTime @default(now())
  checkedInAt DateTime?
  notes     String?

  // Relations
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: SetNull)

  @@map("event_attendees")
}

// Program Management Models
model Program {
  id          String     @id @default(cuid())
  name        String
  description String
  type        ProgramType
  status      ProgramStatus @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime?
  budget      Float?
  location    String?
  coordinator String?    // Program coordinator
  goals       String[]   // Program goals
  metrics     Json?      // Key performance indicators
  imageUrl    String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  assignments VolunteerAssignment[]
  beneficiaries Beneficiary[]
  reports     ProgramReport[]

  @@map("programs")
}

model Beneficiary {
  id          String   @id @default(cuid())
  programId   String
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  phone       String?
  email       String?
  school      String?
  grade       String?
  enrollmentDate DateTime @default(now())
  status      BeneficiaryStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("beneficiaries")
}

model ProgramReport {
  id          String   @id @default(cuid())
  programId   String
  title       String
  content     String
  period      String   // Reporting period
  metrics     Json     // Performance data
  attachments String[] // File URLs
  status      ReportStatus @default(DRAFT)
  submittedBy String?
  submittedAt DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_reports")
}

model SchoolBuilding {
  id          String   @id @default(cuid())
  title       String
  description String
  phase       String   // e.g., "Foundation", "Walls", "Roofing", etc.
  status      String   @default("pending") // pending, in_progress, completed, delayed
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  progress    Int      @default(0) // 0-100 percentage
  imageUrl    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("school_building")
}

model SuccessStory {
  id           String   @id @default(cuid())
  studentName  String
  age          Int?
  story        String
  impact       String
  category     String   @default("education") // education, community, volunteer, etc.
  imageUrl     String?
  isFeatured   Boolean  @default(false)
  status       String   @default("published") // draft, published, archived
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("success_stories")
}

// Enums for Volunteer Management
enum VolunteerStatus {
  PENDING
  APPROVED
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum Availability {
  WEEKDAYS
  WEEKENDS
  FLEXIBLE
  SPECIFIC_DAYS
}

enum AssignmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum HourStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  ID_CARD
  PASSPORT
  RESUME
  CERTIFICATE
  BACKGROUND_CHECK
  MEDICAL_FORM
  AGREEMENT
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum CertificationStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum TrainingType {
  ORIENTATION
  SKILLS_TRAINING
  SAFETY_TRAINING
  LEADERSHIP
  FIRST_AID
  CHILD_PROTECTION
}

enum TrainingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum CommunicationType {
  WELCOME
  REMINDER
  ANNOUNCEMENT
  SURVEY
  WARNING
  APPRECIATION
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  RESPONDED
}

// Event Enums
enum EventType {
  FUNDRAISING
  VOLUNTEER_ORIENTATION
  COMMUNITY_SERVICE
  TRAINING
  AWARENESS_CAMPAIGN
  RECRUITMENT_DRIVE
  CELEBRATION
  MEETING
}

enum EventStatus {
  PLANNING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

enum AttendeeStatus {
  REGISTERED
  CONFIRMED
  CHECKED_IN
  NO_SHOW
  CANCELLED
}

// Program Enums
enum ProgramType {
  EDUCATION
  MENTORSHIP
  HEALTH
  NUTRITION
  COMMUNITY_DEVELOPMENT
  ADVOCACY
  RESEARCH
}

enum ProgramStatus {
  PLANNING
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED
}

enum BeneficiaryStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  SUSPENDED
  INACTIVE
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}
