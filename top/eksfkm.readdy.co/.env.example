# Environment Variables Example
# Copy this file to .env and fill in your values

# Vite Configuration
VITE_BASE_PATH=/

# Analytics (Optional)
VITE_POSTHOG_API_KEY=your_posthog_api_key
VITE_POSTHOG_HOST=https://app.posthog.com

# Google Analytics 4 (Optional)
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Readdy AI (Optional)
VITE_READDY_PROJECT_ID=your_readdy_project_id

# Contact Form (Optional)
VITE_CONTACT_FORM_ENDPOINT=https://api.example.com/contact

# Donation Processing (Optional)
VITE_DONATION_API_KEY=your_donation_api_key
VITE_DONATION_ENDPOINT=https://api.payment-provider.com
