# Environment Variables Example
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env file to version control!

# Vite Configuration
VITE_BASE_PATH=/

# === CRITICAL PRODUCTION VARIABLES ===
# Database & Authentication
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend API
VITE_API_URL=https://your-api-domain.com

# === OPTIONAL ANALYTICS & MARKETING ===
# Google Analytics 4
VITE_GA4_MEASUREMENT_ID=G-1LJ22PMJM4

# PostHog Analytics (Alternative)
VITE_POSTHOG_API_KEY=your_posthog_api_key
VITE_POSTHOG_HOST=https://app.posthog.com

# === OPTIONAL INTEGRATIONS ===
# Readdy AI (Image Generation)
VITE_READDY_PROJECT_ID=your_readdy_project_id

# Contact Form Processing
VITE_CONTACT_FORM_ENDPOINT=https://api.example.com/contact

# Donation Processing
VITE_DONATION_API_KEY=your_donation_api_key
VITE_DONATION_ENDPOINT=https://api.payment-provider.com

# === DEVELOPMENT ONLY ===
# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_DEBUG_MODE=false
