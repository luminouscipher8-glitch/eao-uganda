    "i18next-browser-languagedetector": "^7.2.0",
    "lucide-react": "^0.563.0",
    "postgres": "^3.4.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "react-i18next": "^13.5.0",
    "react-router-dom": "^6.30.3",
    "tailwind-merge": "^3.4.0"
